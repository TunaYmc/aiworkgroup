# ==============================================================================
# AI Employee Multi-Tenant SaaS Environment Variables (.env)
# ==============================================================================

# General Application Settings
ENVIRONMENT=development
LOG_LEVEL=info
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Database (PostgreSQL with pgvector)
# Inside Docker network: postgresql+asyncpg://postgres:postgres@postgres:5432/yapayzekacalisan
# Local host access: postgresql+asyncpg://postgres:postgres@localhost:5432/yapayzekacalisan
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/yapayzekacalisan
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yapayzekacalisan
POSTGRES_PORT=5432

# Redis & Celery Queue
# Inside Docker network: redis://redis:6379/0
# Local host access: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO S3 Compatible)
# Inside Docker network: http://minio:9000
# Local host access: http://localhost:9000
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=tenants
S3_REGION=us-east-1

# LLM Gateway (OpenRouter API)
# Get your API key at https://openrouter.ai/keys
# (Leave as is for deterministic offline test mode)
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEFAULT_LLM_MODEL=anthropic/claude-3.7-sonnet
FALLBACK_LLM_MODEL=openai/gpt-4o-mini

# Agent Runtime (OpenClaw Agent Harness / Gateway)
# Inside Docker network: http://openclaw:8080
# Local host access: http://localhost:8080
OPENCLAW_GATEWAY_URL=http://localhost:8080
OPENCLAW_PORT=8080
DEFAULT_WORKSPACE_ROOT=/data/tenants

# Security & Authentication
# IMPORTANT: Generate a random 32+ character key for production
JWT_SECRET=super-secret-jwt-signing-key-replace-in-prod-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Observability
PROMETHEUS_METRICS_ENABLED=true
